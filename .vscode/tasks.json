{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Maven: package",
      "type": "shell",
      "command": "mvn",
      "args": ["-B", "-DskipTests", "package"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$javac"
    }
  ]
}
